{
  "name": "@foss-earth/renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Host-supplied render scheduling, readiness and device resource ownership",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./babylon": {
      "source": "./src/babylon/index.ts",
      "types": "./dist/babylon/index.d.ts",
      "import": "./dist/babylon/index.js"
    },
    "./google-preparation": {
      "source": "./src/babylon/google.ts",
      "types": "./dist/babylon/google.d.ts",
      "import": "./dist/babylon/google.js"
    },
    "./panel": {
      "source": "./src/panel/index.ts",
      "types": "./dist/panel/index.d.ts",
      "import": "./dist/panel/index.js"
    },
    "./settings": {
      "source": "./src/settings/catalogue.ts",
      "types": "./dist/settings/catalogue.d.ts",
      "import": "./dist/settings/catalogue.js"
    },
    "./package.json": "./package.json",
    "./profiling": {
      "source": "./src/profiling/index.ts",
      "types": "./dist/profiling/index.d.ts",
      "import": "./dist/profiling/index.js"
    },
    "./frame-budget.css": {
      "source": "./src/styles/frameBudget.css",
      "default": "./dist/styles/frameBudget.css"
    },
    "./diagnostics": {
      "source": "./src/babylon/diagnostics/index.ts",
      "types": "./dist/babylon/diagnostics/index.d.ts",
      "import": "./dist/babylon/diagnostics/index.js"
    },
    "./vite": {
      "source": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./google-TS": {
      "types": "./google-TS/index.d.ts",
      "source": "./google-TS/index.js",
      "import": "./google-TS/index.js",
      "default": "./google-TS/index.js"
    },
    "./google-WASM": {
      "types": "./google-WASM/index.d.ts",
      "source": "./google-WASM/index.js",
      "import": "./google-WASM/index.js",
      "default": "./google-WASM/index.js"
    },
    "./google-WASM/worker": {
      "types": "./google-WASM/worker.d.ts",
      "source": "./google-WASM/worker.js",
      "import": "./google-WASM/worker.js",
      "default": "./google-WASM/worker.js"
    },
    "./google-WASM/wasm": "./google-WASM/single/google.wasm"
  },
  "files": [
    "dist",
    "src",
    "google-TS",
    "google-WASM",
    "docs",
    "tests",
    "fixtures",
    "scripts",
    "README.md",
    "LICENSE",
    "tsconfig*.json",
    "eslint.config.mjs",
    "vitest.config.ts",
    "NOTICE",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.tsbuildinfo",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "test": "vitest run --maxWorkers=50%",
    "test:consumer": "node fixtures/consumer.mjs && tsc -p fixtures/tsconfig.json && tsc -p fixtures/tsconfig.public.json && npm run test:vite:node && npm run test:vite:types",
    "test:vite:node": "node fixtures/vite/check-node-import.mjs",
    "test:vite:types": "tsc -p fixtures/vite/tsconfig.public.json",
    "test:vite:graph": "node fixtures/vite/check-built-graph.mjs",
    "build:wasm": "node google-WASM/scripts/build.mjs",
    "check:wasm": "node google-WASM/scripts/check.mjs",
    "test:wasm": "node --test google-WASM/tests/*.test.mjs",
    "check:implementation": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:consumer",
    "ci": "npm run check:implementation"
  },
  "peerDependencies": {
    "@babylonjs/core": "8.56.2",
    "@foss-earth/ui": "0.1.0",
    "vite": "8.3.4"
  },
  "peerDependenciesMeta": {
    "@babylonjs/core": {
      "optional": true
    },
    "@foss-earth/ui": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babylonjs/core": "8.56.2",
    "@babylonjs/loaders": "8.56.2",
    "@types/node": "24.12.4",
    "eslint": "9.39.4",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.6",
    "@foss-earth/ui": "0.1.0",
    "vite": "8.3.4"
  }
}
